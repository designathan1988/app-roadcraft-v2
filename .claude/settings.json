{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^mcp__(Claude_Browser__(preview_start|navigate|tabs_create)|claude-in-chrome__(navigate|tabs_create_mcp))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
