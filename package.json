{
  "name": "roadcraft",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "description": "Roadcraft — a 3D isometric road-building and traffic-simulation game for the browser",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-limited.mjs npm run build:raw",
    "build:raw": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-limited.mjs npm run test:raw",
    "test:raw": "vitest run",
    "test:watch": "node scripts/run-limited.mjs npm run test:watch:raw",
    "test:watch:raw": "vitest",
    "test:coverage": "node scripts/run-limited.mjs npm run test:coverage:raw",
    "test:coverage:raw": "vitest run --coverage",
    "check": "node scripts/run-limited.mjs npm run check:raw",
    "check:raw": "npm run lint && npm run typecheck && npm run test:coverage:raw && npm run build:raw",
    "verify": "npm run check && npm run verify:visual && npm run verify:citizens",
    "verify:citizens": "node scripts/run-limited.mjs npm run verify:citizens:raw",
    "verify:citizens:raw": "npm run build:raw && node scripts/verify-citizens.mjs",
    "verify:visual": "node scripts/run-limited.mjs npm run verify:visual:raw",
    "verify:visual:raw": "npm run build:raw && node scripts/verify-visual.mjs",
    "verify:buildings": "node scripts/run-limited.mjs npm run verify:buildings:raw",
    "verify:buildings:raw": "npm run build:raw && node scripts/verify-buildings.mjs",
    "screens": "node scripts/run-limited.mjs npm run screens:raw",
    "screens:raw": "npm run build:raw && node scripts/verify-visual.mjs -- --shots",
    "cook:people": "node scripts/cook-people.mjs",
    "verify:ui": "node scripts/run-limited.mjs npm run verify:ui:raw",
    "verify:ui:raw": "npm run build:raw && node scripts/verify-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "meshoptimizer": "1.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "clipper2-ts": "^2.0.1-18",
    "earcut": "^3.2.3",
    "jolt-physics": "^1.1.0",
    "polygon-clipping": "0.15.7",
    "recast-navigation": "^0.43.1",
    "three": "^0.186.0"
  }
}
